@@ -0,0 +1,29 @@
+package dev.comfyfluffy.caustica.api.program;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.UncheckedIOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+
+/**
+ * Development shader sources: with {@code -Dcaustica.dev.shaderDir=DIR}, a classpath shader resource is read from
+ * {@code DIR/<resource path>} when that file exists, so a resource reload recompiles edited sources without a new jar.
+ */
+public final class DevShaderOverride {
+    private static final String DIRECTORY = System.getProperty("caustica.dev.shaderDir");
+
+    private DevShaderOverride() { }
+
+    /** The development copy of the classpath resource {@code resource} (absolute, '/'-separated), or null. */
+    public static InputStream open(String resource) {
+        if (DIRECTORY == null) return null;
+        Path file = Path.of(DIRECTORY, resource.substring(1));
+        if (!Files.isRegularFile(file)) return null;
+        try {
+            return Files.newInputStream(file);
+        } catch (IOException failure) {
+            throw new UncheckedIOException(failure);
+        }
+    }
+}
