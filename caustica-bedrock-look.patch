@@ -0,0 +1,23 @@
+package dev.comfyfluffy.caustica.api.program;
+
+import java.util.Map;
+
+/**
+ * Development look tuning for the test rig: named overrides of look constants that the rig changes while the game
+ * runs (minecraft-client's RtLiveTune reads them from {@code -Dcaustica.dev.tune}). Without an override a read
+ * returns the constant it is given.
+ */
+public final class DevTune {
+    private static volatile Map<String, Float> values = Map.of();
+
+    private DevTune() { }
+
+    public static float get(String key, float value) {
+        Float override = values.get(key);
+        return override == null ? value : override;
+    }
+
+    public static void set(Map<String, Float> overrides) {
+        values = Map.copyOf(overrides);
+    }
+}
