+     * Semantic page texels per albedo texel: the widest of the normal and specular maps relative to the
+     * sprite, so a low-resolution albedo keeps its high-resolution relief.
+     */
+    private static int pageScale(int width, int height, Optional<Resource> spec, Optional<Resource> normal) {
+        int scale = 1;
+        for (Optional<Resource> companion : List.of(spec, normal)) {
+            if (companion.isEmpty()) continue;
+            int companionWidth = pngWidth(companion.get());
+            if (companionWidth > width) scale = Math.max(scale, companionWidth / width);
