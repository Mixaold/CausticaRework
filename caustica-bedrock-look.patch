+    private final float[] drops = new float[MAX_DROPS * 6];
+    private ShaderObjectGraphics pipeline;
+    private VmaMappedHostBuffer rainVbo, snowVbo;
+    private int rainCount, snowCount;
+    private int tlasDescriptor;
+    private float brightness, intensity;
+
+    PrecipitationFeature(RtEntities entities, RtTerrain terrain) {
+        this.entities = entities;
+        this.terrain = java.util.Objects.requireNonNull(terrain, "terrain");
+    }
+
+    @Override public boolean prepare(GpuDevice device, OverlayFrameBuffers pool, FrameResources frameResources,
+            int worldTlasDescriptor, Matrix4fc worldViewProjection, int width, int height) {
+        if (worldTlasDescriptor == 0) return false;
+        Minecraft minecraft = Minecraft.getInstance();
+        ClientLevel level = minecraft.level;
+        RtTerrain current = terrain.currentOrNull();
+        if (level == null || current == null) return false;
+        intensity = level.getRainLevel(1.0f);
+        if (intensity <= 0.01f) return false;
+        double cameraX = current.blockX + entities.glowCamOffsetX();
+        double cameraY = current.blockY + entities.glowCamOffsetY();
+        double cameraZ = current.blockZ + entities.glowCamOffsetZ();
+        int centerX = (int) Math.floor(cameraX), centerY = (int) Math.floor(cameraY), centerZ = (int) Math.floor(cameraZ);
+        double seconds = (System.nanoTime() % 3_600_000_000_000L) * 1.0e-9;
+        BlockPos.MutableBlockPos pos = new BlockPos.MutableBlockPos();
+
+        rainCount = 0;
+        int snowStart = drops.length;
+        snowCount = 0;
+        for (int x = centerX - RADIUS; x <= centerX + RADIUS; x++) {
+            for (int z = centerZ - RADIUS; z <= centerZ + RADIUS; z++) {
+                int ground = level.getHeight(Heightmap.Types.MOTION_BLOCKING, x, z);
+                int bottom = Math.max(ground, centerY - SPAN), top = centerY + SPAN;
+                if (bottom >= top) continue;
+                pos.set(x, bottom, z);
+                Biome.Precipitation kind = level.getBiome(pos).value().getPrecipitationAt(pos, level.getSeaLevel());
+                if (kind == Biome.Precipitation.NONE) continue;
+                boolean snow = kind == Biome.Precipitation.SNOW;
+                float spacing = snow ? SNOW_SPACING : RAIN_SPACING;
+                float speed = snow ? SNOW_SPEED : RAIN_SPEED;
+                float length = snow ? SNOW_LENGTH : RAIN_LENGTH;
+                int seed = x * 73856093 ^ z * 19349663;
+                // Drops sit on a lattice that falls with the world, so they keep their place as the camera moves.
+                double fall = seconds * speed / spacing + hash(seed);
+                // The lattice offset shrinks as time passes, so every drop moves down.
+                double phase = 1.0 - (fall - Math.floor(fall));
+                for (double y = Math.floor(bottom / spacing) * spacing + phase * spacing; y < top; y += spacing) {
+                    if (y < bottom) continue;
+                    int drop = (int) Math.floor(y / spacing);
+                    float jitterX = hash(seed + drop * 31) - 0.5f;
+                    float jitterZ = hash(seed + drop * 57 + 11) - 0.5f;
+                    if (hash(seed + drop * 101 + 7) > intensity) continue;
+                    double sway = snow ? 0.25 * Math.sin(seconds * 1.3 + drop + seed * 0.01) : 0.0;
+                    float px = (float) (x + 0.5 + 0.8 * jitterX + sway - current.blockX);
+                    float pz = (float) (z + 0.5 + 0.8 * jitterZ - current.blockZ);
+                    float py = (float) (y - current.blockY);
+                    // Rain fills the array from the front and snow from the back.
+                    if (snowStart - rainCount * 6 < 6) continue;
+                    int at;
+                    if (snow) {
+                        snowStart -= 6;
+                        at = snowStart;
+                        snowCount++;
+                    } else {
+                        at = rainCount * 6;
+                        rainCount++;
+                    }
+                    drops[at] = px; drops[at + 1] = py + length; drops[at + 2] = pz;
+                    drops[at + 3] = px; drops[at + 4] = py; drops[at + 5] = pz;
+                }
+            }
+        }
+        if (rainCount == 0 && snowCount == 0) return false;
+        ensurePipeline(device);
+        rainVbo = upload(device, pool, 0, rainCount, "rain vbo");
+        snowVbo = upload(device, pool, snowStart, snowCount, "snow vbo");
+        brightness = Math.clamp(1.0f - level.getSkyDarken() / 12.0f, 0.12f, 1.0f);
+        viewProj.set(worldViewProjection);
+        tlasDescriptor = worldTlasDescriptor;
+        return true;
+    }
+
+    private VmaMappedHostBuffer upload(GpuDevice device, OverlayFrameBuffers pool, int start, int count, String name) {
+        if (count == 0) return null;
+        long bytes = (long) count * 6 * Float.BYTES;
+        VmaMappedHostBuffer vbo = pool.acquireVertex(device, bytes, name);
+        FloatBuffer target = vbo.mapped().order(ByteOrder.nativeOrder()).asFloatBuffer();
+        target.put(drops, start, count * 6);
+        vbo.flush(0, bytes);
+        return vbo;
+    }
+
+    private void ensurePipeline(GpuDevice gpu) {
+        if (pipeline == null) {
+            pipeline = new OverlayPipelines.Spec("block_outline/vertex.vert.spv", "block_outline/fragment.frag.spv")
+                    .vertex(OverlayPipelines.EDGE_POSITION_PAIR)
+                    .fragmentAccelerationStructure(0, 0, TLAS_INDEX_OFFSET)
+                    .blend(OverlayPipelines.ALPHA_BLEND)
+                    .build(gpu);
+        }
+    }
+
+    @Override public void record(VkCommandBuffer cmd, long targetView, int width, int height) {
+        try (MemoryStack stack = MemoryStack.stackPush()) {
+            WorldOverlayPass.beginColorRendering(cmd, stack, targetView, width, height, false);
+            float b = brightness;
+            if (rainVbo != null) draw(cmd, stack, rainVbo, rainCount, RAIN_HALF_WIDTH,
+                    0.68f * b, 0.72f * b, 0.80f * b, RAIN_ALPHA * intensity, width, height);
+            if (snowVbo != null) draw(cmd, stack, snowVbo, snowCount, SNOW_HALF_WIDTH,
+                    0.95f * b, 0.96f * b, 1.0f * b, SNOW_ALPHA * intensity, width, height);
+            WorldOverlayPass.endRendering(cmd);
+        }
+    }
+
+    private void draw(VkCommandBuffer cmd, MemoryStack stack, VmaMappedHostBuffer vbo, int count, float halfWidth,
+            float r, float g, float b, float a, int width, int height) {
+        VK10.vkCmdBindVertexBuffers(cmd, 0, stack.longs(vbo.buffer()), stack.longs(0));
+        ByteBuffer push = stack.malloc(PUSH_BYTES).order(ByteOrder.LITTLE_ENDIAN);
+        viewProj.get(0, push);
+        push.putFloat(64, entities.glowCamOffsetX());
+        push.putFloat(68, entities.glowCamOffsetY());
+        push.putFloat(72, entities.glowCamOffsetZ());
+        push.putFloat(76, halfWidth);
+        push.putFloat(80, r).putFloat(84, g).putFloat(88, b).putFloat(92, a);
+        push.putInt(TLAS_INDEX_OFFSET, tlasDescriptor);
+        push.putFloat(100, 1f / width).putFloat(104, 1f / height).putInt(108, 0);
+        pipeline.bind(cmd, push, width, height);
+        VK10.vkCmdDraw(cmd, 6, count, 0, 0);
+    }
+
+    /** A stable pseudo-random value in [0, 1) for an integer key. */
+    private static float hash(int key) {
+        int h = key * 0x9E3779B1;
+        h ^= h >>> 15;
+        h *= 0x85EBCA77;
+        h ^= h >>> 13;
+        return (h >>> 8) * (1.0f / (1 << 24));
+    }
+
+    @Override public void close() {
+        try (var shader = pipeline) {
+            pipeline = null;
+        }
+    }
+}
