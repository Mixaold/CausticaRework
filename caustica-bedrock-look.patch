@@ -0,0 +1,60 @@
+package dev.comfyfluffy.caustica.support;
+
+import java.util.Set;
+import java.util.concurrent.ConcurrentHashMap;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Fork idea 8 diagnostics: primitive binding addresses of the one entity whose hurt flash is being traced, so the
+ * renderer can log what it does with that entity's mesh without knowing about Minecraft entities.
+ */
+public final class ForkTrace {
+    private static final Set<Long> BINDINGS = ConcurrentHashMap.newKeySet();
+    private static final AtomicInteger LINES = new AtomicInteger();
+    private static final int LINE_LIMIT = 600;
+    /** Binding address -> {nanoTime of its put, reddened vertex count}. */
+    private static final java.util.Map<Long, long[]> PUTS = new ConcurrentHashMap<>();
+    private static volatile long start;
+
+    private ForkTrace() { }
+
+    public static void watchBinding(long address) {
+        if (BINDINGS.size() < 256) BINDINGS.add(address);
+    }
+
+    /** Remembers when the mesh behind a binding was put and how many of its vertices were reddened. */
+    public static void watchBinding(long address, long putNanos, int reddened) {
+        if (BINDINGS.size() >= 256) return;
+        BINDINGS.add(address);
+        PUTS.put(address, new long[] {putNanos, reddened});
+    }
+
+    /** "put +T ms, reddened N, put X ms ago" for a watched binding, or an empty string. */
+    public static String describe(long address) {
+        long[] put = PUTS.get(address);
+        if (put == null) return "";
+        long now = System.nanoTime();
+        return " [put at +" + (put[0] - start) / 1_000_000L + " ms of the trace, reddened " + put[1]
+                + ", put " + (now - put[0]) / 1_000_000L + " ms ago]";
+    }
+
+    public static long millisSinceStart() {
+        return (System.nanoTime() - start) / 1_000_000L;
+    }
+
+    public static void clear() {
+        BINDINGS.clear();
+        PUTS.clear();
+        LINES.set(0);
+        start = System.nanoTime();
+    }
+
+    public static boolean watched(long address) {
+        return !BINDINGS.isEmpty() && BINDINGS.contains(address);
+    }
+
+    /** True while the current trace may still write a line. */
+    public static boolean line() {
+        return LINES.incrementAndGet() <= LINE_LIMIT;
+    }
+}
