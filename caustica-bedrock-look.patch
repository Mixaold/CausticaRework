+
+import dev.comfyfluffy.caustica.api.program.DevTune;
+
+/**
+ * Host-set inputs of the display grade. The host writes them on its frame thread; the display pass reads
+ * the latest value when it records.
+ */
+public final class DisplayGrade {
+    /** Strength in [0, 1] of the moonlit blue shift; a dimension without a night sky sets 0. */
+    public static volatile float night = 0.0f;
+    /** Strength in [0, 1] of the daylight shadow balance and lift; 0 at night and without a sky. */
+    public static volatile float day = 0.0f;
+    /** Strength in [0, 1] of the warm golden-hour shift while the sun is low; 0 elsewhere. */
+    public static volatile float sunsetWarmth = 0.0f;
+    /** 1 while the camera is under water, where the grade's saturation takes UNDERWATER_SATURATION; 0 elsewhere. */
+    public static volatile float submerged = 0.0f;
+    /** EV added to auto exposure while the sun is high (Bedrock renders noon darker than morning); 0 elsewhere. */
+    public static volatile float exposureBias = 0.0f;
+    /**
+     * Exposure EV set by the time of day, as Bedrock RTX exposes without metering the image: while finite it replaces
+     * auto exposure. NaN (no sky) leaves auto exposure on.
+     */
+    public static volatile float timeEv = Float.NaN;
+    /**
+     * Added to the display gamma while the sun is low (sunrise, sunset): the owner's preset wants gamma 0.95 and
+     * EV -1.73 then, against 0.92 and -1.3 by day and at night (26.10). 0 elsewhere.
+     */
+    public static volatile float gammaOffset = 0.0f;
+    /** Mix in [0, 1] of the graded image over the tone mapper's own output. */
+    public static volatile float strength = 1.0f;
+
+    /**
+     * The grade's controls in DisplayPush order (saturation .. white balance), fitted against Bedrock captures:
+     * saturation; daylight shadow lift and the display luminance it fades out by; matte floor; log contrast and
+     * gamma of display luminance; daylight shadow balance; night tint, its strength, desaturation and extra
+     * saturation; white balance; golden-hour extra saturation, share of its tint and that tint; the night's shadow
+     * lift (Bedrock's night shade stays readable, never black). Daylight shade is warm like Bedrock's sand in
+     * shadow, not grey (owner 27.10).
+     */
+    private static final String[] KEYS = {"grade.saturation", "grade.lift", "grade.liftEnd", "grade.matte",
+            "grade.contrast", "grade.gamma", "grade.shadowR", "grade.shadowG", "grade.shadowB", "grade.nightR",
+            "grade.nightG", "grade.nightB", "grade.nightStrength", "grade.nightDesaturation", "grade.nightSaturation",
+            "grade.balanceR", "grade.balanceG", "grade.balanceB", "grade.sunsetSaturation", "grade.sunsetWarmth",
+            "grade.sunsetTintR", "grade.sunsetTintG", "grade.sunsetTintB", "grade.nightLift"};
+    private static final float[] DEFAULTS = {0.97f, 3.0f, 0.35f, 0.0f, 1.0f, 1.0f, 1.12f, 1.04f, 0.78f, 0.7f,
+            1.0f, 1.2f, 0.4f, 0.5f, 0.0f, 1.0f, 1.0f, 1.0f, 0.0f, 0.5f, 1.2f, 0.97f, 0.72f, 0.0f};
+
+    /** Multiple of the grade's saturation under water: Bedrock's water is a muted teal, not neon blue. */
+    private static final float UNDERWATER_SATURATION = 1.0f;
+
+    public static void strength(float value) { strength = value; }
+
+    /** The grade's controls in DisplayPush order. */
+    static float[] controls() {
+        float[] controls = new float[KEYS.length];
+        for (int i = 0; i < KEYS.length; i++) controls[i] = DevTune.get(KEYS[i], DEFAULTS[i]);
