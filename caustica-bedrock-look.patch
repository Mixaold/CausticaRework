+package dev.comfyfluffy.caustica.minecraft.client.program;
+
+import com.mojang.blaze3d.platform.NativeImage;
+import dev.comfyfluffy.caustica.api.program.DevTune;
+import dev.comfyfluffy.caustica.renderer.presentation.fog.FogClouds;
+import dev.comfyfluffy.caustica.support.ColorSpaces;
+import net.minecraft.client.Camera;
+import net.minecraft.client.CloudStatus;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.resources.Identifier;
+import net.minecraft.util.ARGB;
+import net.minecraft.world.attribute.EnvironmentAttributes;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.UncheckedIOException;
+
+/**
+ * Vanilla's cloud layer as a shadow on sunlight and as clouds in the traced sky. The pattern, cell size, thickness and drift follow the vanilla
+ * cloud renderer, so the shadows move with the clouds the level would draw: {@code clouds.png} tiles cells of 12
+ * blocks, a texel with alpha of at least 10 is a cloud, and the layer drifts 0.03 blocks per game tick along +X.
+ */
+final class MinecraftCloudLayer {
+    /**
+     * Share of direct sunlight a cloud stops at full daylight; the sky still lights the ground beneath it. Bedrock RTX
+     * casts soft blocky cloud shadows on land and water (owner's capture 22.10 21:10), lighter than a full shade.
+     */
+    private static final float SHADOW = 0.7f;
+    /**
+     * Gain on the clouds' lit colour by day and at night: the camera-seen sky is far brighter than the physical one
+     * (SkyLutPass view gain), and a cloud is never drawn darker than the sky behind it, so without it they vanish.
+     */
+    private static final float CLOUD_GAIN = 6.0f;
+    private static final float CLOUD_GAIN_NIGHT = 1.2f;
+    private static final float CELL_SIZE = 12.0f;
+    private static final float THICKNESS = 4.0f;
+    private static final int TICKS_PER_CELL = 400;
+    private static final double DRIFT_PER_TICK = 0.03;
+    private static final double Z_SHIFT = 3.96;
+    private static final Identifier TEXTURE = Identifier.withDefaultNamespace("textures/environment/clouds.png");
+    private int[] mask;
+    private int width;
+    private int depth;
+
+    /**
+     * The cloud layer over {@code level} this frame; {@code daylight} fades the shadow in from sunrise. The clouds stay
+     * in the sky at night, lit by the moon and the night sky.
+     */
+    FogClouds capture(ClientLevel level, Camera camera, float daylight) {
+        Minecraft minecraft = Minecraft.getInstance();
+        float partialTick = minecraft.getDeltaTracker().getGameTimeDeltaPartialTick(false);
+        int colour = camera.attributeProbe().getValue(EnvironmentAttributes.CLOUD_COLOR, partialTick);
+        float strength = DevTune.get("clouds.shadow", SHADOW) * daylight;
+        if (minecraft.options.getCloudStatus() == CloudStatus.OFF || ARGB.alpha(colour) == 0) {
+            return FogClouds.NONE;
+        }
+        if (mask == null) load(minecraft);
+        float height = camera.attributeProbe().getValue(EnvironmentAttributes.CLOUD_HEIGHT, partialTick);
+        double ticks = level.getGameTime() % ((long) width * TICKS_PER_CELL) + partialTick;
+        float[] tint = ColorSpaces.srgbToAcesCg(ARGB.red(colour) / 255.0, ARGB.green(colour) / 255.0,
+                ARGB.blue(colour) / 255.0);
+        float night = DevTune.get("sky.cloudGainNight", CLOUD_GAIN_NIGHT);
+        float gain = night + daylight * (DevTune.get("sky.cloudGain", CLOUD_GAIN) - night);
+        for (int i = 0; i < 3; i++) tint[i] *= gain;
+        return new FogClouds(mask, width, depth, CELL_SIZE, THICKNESS, height, ticks * DRIFT_PER_TICK, Z_SHIFT,
+                Math.max(strength, 0.0f), tint, ARGB.alpha(colour) / 255.0f);
+    }
+
+    private void load(Minecraft minecraft) {
+        try (InputStream stream = minecraft.getResourceManager().open(TEXTURE);
+             NativeImage image = NativeImage.read(stream)) {
+            width = image.getWidth();
+            depth = image.getHeight();
+            int[] bits = new int[(width * depth + 31) / 32];
+            for (int z = 0; z < depth; z++) {
+                for (int x = 0; x < width; x++) {
+                    int index = x + z * width;
+                    if (ARGB.alpha(image.getPixel(x, z)) >= 10) bits[index >>> 5] |= 1 << (index & 31);
+                }
+            }
+            mask = bits;
+        } catch (IOException failure) {
+            throw new UncheckedIOException(failure);
+        }
+    }
+}
