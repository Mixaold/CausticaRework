+    float scale = frame.firstPersonClip.z;
+    hit.hitDistance = intersection.hitDistance * scale;
+    hit.position = frame.camOffset + cameraDirection * hit.hitDistance;
+    hit.geometricNormal = normalize(mul(frame.firstPersonToScene, float4(hit.geometricNormal, 0.0)).xyz);
+    // The hand's field of view differs from the world's, so a face seen at a grazing angle on the stage can face
+    // away from the camera ray. The shading normal turns with the geometric one; lifted alone it would stay grazing
+    // and shade the face almost black (long held items reach the screen edges, where the two projections part most).
