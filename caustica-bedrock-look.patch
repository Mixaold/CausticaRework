@@ -0,0 +1,36 @@
+package dev.comfyfluffy.caustica.api.program;
+
+import java.util.concurrent.atomic.AtomicLong;
+
+/**
+ * Lighting discontinuities that cached indirect light cannot follow: the sky jumping to another time of day (a time
+ * skip or sleep) and a light source appearing or vanishing near the camera (a torch placed or broken). The renderer
+ * drops its radiance cache whenever {@link #count()} moves, instead of letting the old light fade over many seconds.
+ */
+public final class LightingChanges {
+    /** Emitter changes farther than this from the camera (blocks) leave the cache alone; distant ones barely show. */
+    private static final double NEAR = 32.0;
+    private static final AtomicLong count = new AtomicLong();
+    private static volatile double cameraX = Double.NaN, cameraY, cameraZ;
+
+    private LightingChanges() { }
+
+    public static long count() {
+        return count.get();
+    }
+
+    public static void skyJumped() {
+        count.incrementAndGet();
+    }
+
+    public static void camera(double x, double y, double z) {
+        cameraX = x;
+        cameraY = y;
+        cameraZ = z;
+    }
+
+    public static void emitterChanged(double x, double y, double z) {
+        double dx = x - cameraX, dy = y - cameraY, dz = z - cameraZ;
+        if (dx * dx + dy * dy + dz * dz <= NEAR * NEAR) count.incrementAndGet();
+    }
+}
