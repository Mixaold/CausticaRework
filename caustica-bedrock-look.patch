+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.util.List;
+import java.util.concurrent.CompletableFuture;
+import java.util.function.Consumer;
+import java.util.function.Supplier;
+
+/**
+ * Compiles the first world program of each dimension in the menus, before any world opens. A fresh program
+ * session assigns the implementation slots a world session's first registration assigns, so that world loads
+ * its stored SPIR-V and creates its pipeline from the driver's warm cache instead of compiling on entry.
+ */
+public final class MinecraftProgramPrewarm {
+    private static final Logger LOGGER = LoggerFactory.getLogger(MinecraftProgramPrewarm.class);
+    private static final List<ResourceId> DIMENSIONS = List.of(ResourceId.of("minecraft", "overworld"),
+            ResourceId.of("minecraft", "the_nether"), ResourceId.of("minecraft", "the_end"));
+
+    private final CompletableFuture<Void> finished = new CompletableFuture<>();
+    private volatile boolean stopped;
+
+    private MinecraftProgramPrewarm() { }
+
+    /** Starts compiling on a daemon thread; each dimension uses its own backend from {@code backends}. */
+    public static MinecraftProgramPrewarm start(Supplier<RtProgramBackend> backends) {
+        MinecraftProgramPrewarm prewarm = new MinecraftProgramPrewarm();
+        Thread thread = new Thread(() -> prewarm.run(backends), "Caustica program prewarm");
+        thread.setDaemon(true);
+        thread.start();
+        return prewarm;
+    }
+
+    /** Completes after the dimension being compiled when {@link #stop()} was called, or after all of them. */
+    public CompletableFuture<Void> finished() {
+        return finished;
+    }
+
+    /** Leaves the dimensions not started yet to their world sessions. */
+    public void stop() {
+        stopped = true;
+    }
+
+    private void run(Supplier<RtProgramBackend> backends) {
+        try {
+            for (ResourceId dimension : DIMENSIONS) {
+                if (stopped) break;
+                compile(backends, dimension);
+            }
+        } catch (Throwable failure) {
+            LOGGER.warn("RT program prewarm failed; worlds compile their programs on entry", failure);
+        } finally {
+            finished.complete(null);
+        }
+    }
+
+    private static void compile(Supplier<RtProgramBackend> backends, ResourceId dimension) {
+        long started = System.nanoTime();
+        CompletableFuture<ProgramBackend.Compilation> compiled = new CompletableFuture<>();
+        try (RtProgramBackend backend = backends.get();
+             ResourceDirectory resources = new ResourceDirectory(
+                     failure -> LOGGER.warn("RT program prewarm resource failure", failure));
+             var implementation = MinecraftProgramTypes.IMPLEMENTATION_DATA.data(1L);
+             var binding = MinecraftProgramTypes.PRIMITIVE_DATA.data(1L);
+             var instance = MinecraftProgramTypes.INSTANCE_DATA.data(1L)) {
+            // The candidate is only compiled; the session never publishes it.
+            ProgramBackend compileOnly = new ProgramBackend() {
+                @Override
+                public void compile(ProgramComposition composition, Consumer<? super Compilation> completion) {
+                    backend.compile(composition, compiled::complete);
+                }
+
+                @Override
+                public void publish(CompiledProgram program, Runnable previousRetired) {
+                    throw new IllegalStateException("prewarm programs are not published");
+                }
+
+                @Override
+                public void drainPublishedUses() { }
+            };
+            ProgramSession programs = new ProgramSession(resources, compileOnly,
+                    failure -> LOGGER.warn("RT program prewarm failure", failure));
+            MinecraftProgramSession.registerPrograms(programs.openChannel(),
+                    new MinecraftProgramSession.Roots(implementation, binding, instance), dimension);
+            programs.progress();
+            ProgramBackend.Compilation result = compiled.join();
+            if (result instanceof ProgramBackend.Compilation.Succeeded succeeded) {
+                succeeded.program().close();
+                LOGGER.info("Prewarmed RT program for {} in {} ms", dimension,
+                        (System.nanoTime() - started) / 1_000_000L);
+            } else if (result instanceof ProgramBackend.Compilation.Failed failed) {
+                LOGGER.warn("RT program prewarm for {} failed: {}", dimension, failed.failure().diagnostics());
+            }
+        }
+    }
+}
