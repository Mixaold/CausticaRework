@@ -0,0 +1,20 @@
+package dev.comfyfluffy.caustica.renderer.presentation.fog;
+
+/**
+ * A tiled cloud layer that shades distant lights. {@code mask} holds one bit per cell, bit {@code x + z * width}
+ * of the int array, and repeats every {@code width} by {@code depth} cells. A world point (X, Z) lies in cell
+ * ({@code floor((X + shiftX) / cellSize)}, {@code floor((Z + shiftZ) / cellSize)}) modulo the mask size. The layer
+ * spans {@code thickness} blocks up from world height {@code height}; {@code strength} is the share of direct light a
+ * cloud stops, zero without clouds. The mask array is shared between frames so its upload is reused. The camera sees
+ * the layer in the sky with ACEScg {@code colour} at {@code opacity}; zero opacity leaves only the shadows.
+ */
+public record FogClouds(int[] mask, int width, int depth, float cellSize, float thickness, float height,
+                        double shiftX, double shiftZ, float strength, float[] colour, float opacity) {
+    public static final FogClouds NONE = new FogClouds(new int[1], 1, 1, 1.0f, 1.0f, 0.0f, 0.0, 0.0, 0.0f,
+            new float[]{1.0f, 1.0f, 1.0f}, 0.0f);
+
+    /** This layer's shadows without its clouds in the sky, as from under water. */
+    public FogClouds shadowsOnly() {
+        return new FogClouds(mask, width, depth, cellSize, thickness, height, shiftX, shiftZ, strength, colour, 0.0f);
+    }
+}
