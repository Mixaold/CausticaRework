+package dev.comfyfluffy.caustica.minecraft.client;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import dev.comfyfluffy.caustica.api.program.DevTune;
+import net.minecraft.client.CloudStatus;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.Screenshot;
+import org.slf4j.Logger;
+import org.slf4j.LoggerFactory;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayDeque;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Development look tuning on the test rig: with {@code -Dcaustica.dev.tune=FILE} the running game polls a JSON job
+ * file and, for each new job id, sets its {@link DevTune} overrides, optionally reloads the shaders, then runs its
+ * views in order (chat commands, a settle time, a screenshot into the job file's {@code shots} folder) and writes
+ * {@code shots/done.txt} with the id. A job with {@code "quit": true} closes the game. The parameters
+ * {@code mc.renderDistance}, {@code mc.fov} and {@code mc.clouds} (0 off, 1 fancy) set those video options; chat is
+ * made transparent so command feedback stays out of the screenshots.
+ *
+ * <pre>{"id": 3, "params": {"grade.saturation": 1.2}, "reload": false,
+ *  "views": [{"cmds": ["time set 6000", "tp @s 0 80 0 0 10"], "waitMs": 2500, "shot": "day"}]}</pre>
+ */
+public final class RtLiveTune {
+    private static final Logger LOGGER = LoggerFactory.getLogger("Caustica live tune");
+    private static final String FILE = System.getProperty("caustica.dev.tune");
+    private static final long POLL_NANOS = 300_000_000L;
+    private static long lastPoll;
+    private static long lastModified;
+    private static long jobId = Long.MIN_VALUE;
+    private static boolean reloading;
+    private static final ArrayDeque<JsonObject> views = new ArrayDeque<>();
+    private static JsonObject view;
+    private static long viewStart;
+    private static final AtomicInteger pendingShots = new AtomicInteger();
+    private static boolean writeDone;
+
+    private RtLiveTune() { }
+
+    /** Advances the current job; called at the start of every render frame. */
+    public static void frame() {
+        if (FILE == null) return;
+        Minecraft minecraft = Minecraft.getInstance();
+        if (minecraft.player == null) return;
+        long now = System.nanoTime();
+        if (view == null && views.isEmpty() && !reloading && now - lastPoll > POLL_NANOS) {
+            lastPoll = now;
+            poll(minecraft);
+        }
+        if (reloading) {
+            if (!RtDevReload.settled()) return;
+            reloading = false;
+        }
+        if (view == null && !views.isEmpty()) {
+            view = views.poll();
+            viewStart = now;
+            if (view.has("cmds")) {
+                for (JsonElement command : view.getAsJsonArray("cmds")) {
+                    minecraft.player.connection.sendCommand(command.getAsString());
+                }
+            }
+        }
+        if (view != null) {
+            long wait = view.has("waitMs") ? view.get("waitMs").getAsLong() : 1500L;
+            if ((now - viewStart) / 1_000_000L < wait) return;
+            if (view.has("shot")) shot(minecraft, view.get("shot").getAsString());
+            view = null;
+        }
+        if (writeDone && view == null && views.isEmpty() && pendingShots.get() == 0) {
+            writeDone = false;
+            write(shots().resolve("done.txt"), Long.toString(jobId));
+        }
+    }
+
+    private static void poll(Minecraft minecraft) {
+        Path file = Path.of(FILE);
+        try {
+            if (!Files.isRegularFile(file)) return;
+            long modified = Files.getLastModifiedTime(file).toMillis();
+            if (modified == lastModified) return;
+            lastModified = modified;
+            JsonObject job = JsonParser.parseString(Files.readString(file, StandardCharsets.UTF_8)).getAsJsonObject();
+            long id = job.get("id").getAsLong();
+            if (id == jobId) return;
+            jobId = id;
+            if (job.has("quit") && job.get("quit").getAsBoolean()) {
+                minecraft.stop();
+                return;
+            }
+            Map<String, Float> params = new HashMap<>();
+            if (job.has("params")) {
+                for (var entry : job.getAsJsonObject("params").entrySet()) {
+                    params.put(entry.getKey(), entry.getValue().getAsFloat());
+                }
+            }
+            DevTune.set(params);
+            if (params.containsKey("mc.renderDistance")) {
+                minecraft.options.renderDistance().set(Math.round(params.get("mc.renderDistance")));
+            }
+            if (params.containsKey("mc.fov")) minecraft.options.fov().set(Math.round(params.get("mc.fov")));
+            if (params.containsKey("mc.clouds")) {
+                minecraft.options.cloudStatus().set(params.get("mc.clouds") > 0.5f ? CloudStatus.FANCY : CloudStatus.OFF);
+            }
+            minecraft.options.chatOpacity().set(0.0);
+            minecraft.options.textBackgroundOpacity().set(0.0);
+            if (job.has("reload") && job.get("reload").getAsBoolean()) {
+                reloading = true;
+                RtDevReload.reload();
+            }
+            if (job.has("views")) {
+                for (JsonElement element : job.getAsJsonArray("views")) views.add(element.getAsJsonObject());
+            }
+            writeDone = true;
+            LOGGER.info("Live tune job {}: {} params, {} views", id, params.size(), views.size());
+        } catch (IOException | RuntimeException failure) {
+            LOGGER.warn("Live tune job {} unreadable: {}", file, failure.toString());
+        }
+    }
+
+    private static void shot(Minecraft minecraft, String name) {
+        Path out = shots().resolve(name + ".png");
+        pendingShots.incrementAndGet();
+        Screenshot.takeScreenshot(minecraft.gameRenderer.mainRenderTarget(), image -> {
+            try (image) {
+                Files.createDirectories(out.getParent());
+                image.writeToFile(out);
+            } catch (IOException failure) {
+                LOGGER.warn("Live tune screenshot {} failed: {}", out, failure.toString());
+            } finally {
+                pendingShots.decrementAndGet();
+            }
+        });
+    }
+
+    private static Path shots() {
+        return Path.of(FILE).toAbsolutePath().getParent().resolve("shots");
+    }
+
+    private static void write(Path file, String text) {
+        try {
+            Files.createDirectories(file.getParent());
+            Files.writeString(file, text, StandardCharsets.UTF_8);
+        } catch (IOException failure) {
+            LOGGER.warn("Live tune could not write {}: {}", file, failure.toString());
+        }
+    }
+}
