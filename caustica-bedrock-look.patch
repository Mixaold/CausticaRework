     public static <T> T get(Option<T> option) { return snapshot().get(option); }
+
+    /** Applies {@code value} to the renderer option with this id for the session; used by scripted test runs. */
+    public static void apply(String id, String value) {
+        Option<?> option = store.declaredOptions(FEATURE).stream().filter(o -> o.id().equals(id)).findFirst()
+                .orElseThrow(() -> new IllegalArgumentException("no renderer option " + id));
+        store.apply(FEATURE, option, value);
+    }
 }
