+module fork_weather;
+
+import caustica_types;
+import bindings;
+import world_common;
+import world_minimal;
+import fork_ideas_config;
+
+// Rain response of surfaces and the lightning flash, from WorldPush.forkWeather / forkLightning (ForkWeather on
+// the host). Wet ground darkens and turns glossy, and raindrop rings ripple its shading normal and water's; both
+// stop under any roof SHELTER_HEIGHT blocks overhead. A lightning bolt flashes the sky, which lights everything
+// that sees it.
+static const float WET_DARKEN = 0.45;
+static const float WET_ROUGHNESS = 0.08;
+static const float WET_ROUGHNESS_SHARE = 0.85;
+static const float SHELTER_HEIGHT = 48.0;
+// The roof test traces SHELTER_RAYS rays: straight up and tilted SHELTER_TILT radians toward four sides, so the wet
+// ground and the rings thin out over about a block at the edge of a tree's crown instead of stopping on a line.
+static const int SHELTER_RAYS = 5;
+static const float SHELTER_TILT = 0.35;
+static const float UPWARD_FACE = 0.7;
+static const float LIGHTNING_SKY_GAIN = 6.0;
+static const float3 LIGHTNING_TINT = float3(0.85, 0.9, 1.0);
+
+float forkRippleHash(float2 p) {
+    float3 q = frac(float3(p.x, 19.19, p.y) * 0.1031);
+    q += dot(q, q.yzx + 33.33);
+    return frac((q.x + q.y) * q.z);
+}
+
+// Height-field gradient of expanding raindrop rings: one impact per `cell`-block cell, each ring living
+// `life` seconds. Rings vanish once a pixel covers more than about a block (`footprint`), where they would alias.
+float2 forkRainRippleGradient(float2 xz, float time, float rain, float footprint, float cell, float life,
+        float speed, float width, float wave, float amplitude) {
+    float strength = smoothstep(0.01, 0.24, saturate(rain)) * (1.0 - smoothstep(0.16, 1.1, max(footprint, 0.0)));
+    if (strength <= 1.0e-4) return float2(0.0);
+    float2 baseCell = floor(xz / cell);
+    float2 gradient = float2(0.0);
+    [unroll]
+    for (int z = -1; z <= 1; ++z) {
+        [unroll]
+        for (int x = -1; x <= 1; ++x) {
+            float2 c = baseCell + float2(float(x), float(z));
+            float h0 = forkRippleHash(c + float2(11.7, 3.1));
+            float h1 = forkRippleHash(c + float2(37.2, 9.2));
+            float h2 = forkRippleHash(c + float2(73.4, 2.7));
+            float2 impact = (c + float2(0.15 + 0.7 * h0, 0.15 + 0.7 * h1)) * cell;
+            float age = frac(time / life + h2) * life;
+            float2 delta = xz - impact;
+            float radius = length(delta);
+            if (radius < 1.0e-3) continue;
+            float ring = radius - age * speed;
+            float unit = ring / width;
+            if (abs(unit) > 2.5) continue;
+            float envelope = exp(-0.5 * unit * unit) * exp(-1.25 * age);
+            float phase = ring * wave;
+            float slope = amplitude * envelope * (-sin(phase) * wave - cos(phase) * ring / (width * width));
+            gradient += slope * (delta / radius);
+        }
+    }
+    return gradient * strength;
+}
+
+// Share of the roof test's rays that reach the open sky: 1 in the open, 0 under a roof.
+float forkOpenToSky(float3 position, float3 normal) {
+    float tilt = sin(SHELTER_TILT);
+    float up = cos(SHELTER_TILT);
+    float open = 0.0;
+    [unroll]
+    for (int i = 0; i < SHELTER_RAYS; ++i) {
+        float2 side = i == 1 ? float2(1.0, 0.0) : i == 2 ? float2(-1.0, 0.0) : i == 3 ? float2(0.0, 1.0)
+                : float2(0.0, -1.0);
+        RayDesc ray;
+        ray.Origin = position + normal * 0.02;
+        ray.Direction = i == 0 ? float3(0.0, 1.0, 0.0) : float3(side.x * tilt, up, side.y * tilt);
+        ray.TMin = 0.0;
+        ray.TMax = SHELTER_HEIGHT;
+        RayQuery<RAY_FLAG_ACCEPT_FIRST_HIT_AND_END_SEARCH | RAY_FLAG_FORCE_OPAQUE | RAY_FLAG_SKIP_PROCEDURAL_PRIMITIVES> query;
+        query.TraceRayInline(worldAccelerationStructure(), RAY_FLAG_NONE, WORLD_RAY_MASK_FIRST_PERSON_SECONDARY, ray);
+        query.Proceed();
+        if (query.CommittedStatus() == COMMITTED_NOTHING) open += 1.0;
+    }
+    return open / float(SHELTER_RAYS);
+}
+
+float3 forkTilt(float3 normal, float2 gradient) {
+    return normalize(normal - float3(gradient.x, 0.0, gradient.y));
+}
+
+/** Wets an upward face open to the rain: darker, glossier, with raindrop rings; water gets rings only. */
+public void forkApplyWeather(inout OpenPbrSurface material, SurfaceInput input, bool volume) {
+    if (!FORK_WETNESS) return;
+    float4 weather = ((ConstPtr<WorldPush>)worldBindings.worldPushAddress)[0].forkWeather;
+    if (weather.x <= 0.001 && weather.y <= 0.001) return;
+    if (input.geometricNormal.y < UPWARD_FACE) return;
+    bool water = volume && material.transmission_weight > 0.5 && abs(material.specular_ior - 1.333) < 0.05;
+    if (volume && !water) return;
+    float open = forkOpenToSky(input.position, input.geometricNormal);
+    if (open <= 0.0) return;
+    float2 xz = input.proceduralPosition.xz;
+    if (water) {
+        float2 gradient = open * forkRainRippleGradient(xz, input.time, weather.y, input.textureFootprint,
+                1.1, 0.9, 0.55, 0.05, 40.0, 0.004);
+        material.geometry_normal = forkTilt(material.geometry_normal, gradient);
+        return;
+    }
+    if (material.base_metalness > 0.5 || material.transmission_weight > 0.5) return;
+    float wet = saturate(weather.x) * open;
+    material.base_color *= 1.0 - WET_DARKEN * wet;
+    material.specular_roughness = lerp(material.specular_roughness, WET_ROUGHNESS, WET_ROUGHNESS_SHARE * wet);
+    float2 gradient = forkRainRippleGradient(xz, input.time, weather.y * wet, input.textureFootprint,
+            0.55, 0.6, 0.46, 0.038, 64.0, 0.0022);
+    material.geometry_normal = forkTilt(material.geometry_normal, gradient);
+}
+
+/** Sky radiance during a lightning flash. */
+public float3 forkLightningSky(float3 radiance) {
+    if (!FORK_LIGHTNING) return radiance;
+    float4 weather = ((ConstPtr<WorldPush>)worldBindings.worldPushAddress)[0].forkWeather;
+    float flash = weather.w;
+    if (flash <= 0.0) return radiance;
+    // A bright sky gains LIGHTNING_SKY_GAIN of itself; a dark one is lifted to forkWeather.z cd/m² at the peak.
+    float luminance = dot(radiance, float3(0.2722, 0.6741, 0.0537));
+    return radiance + LIGHTNING_TINT * (flash * max(LIGHTNING_SKY_GAIN * luminance, weather.z));
+}
