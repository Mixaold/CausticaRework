+package dev.comfyfluffy.caustica.minecraft.client;
+
+import dev.comfyfluffy.caustica.minecraft.client.program.MinecraftProgramSession;
+import net.minecraft.client.Minecraft;
+
+/**
+ * Development hooks for the test rig: reload resources so the RT program recompiles its shaders (from
+ * {@code -Dcaustica.dev.shaderDir} when set), then poll until the rebuilt program is active.
+ */
+public final class RtDevReload {
+    private static volatile long target = Long.MAX_VALUE;
+
+    private RtDevReload() { }
+
+    public static void reload() {
+        target = MinecraftProgramSession.activations() + 1;
+        Minecraft.getInstance().reloadResourcePacks();
+    }
+
+    public static boolean settled() {
+        return MinecraftProgramSession.activations() >= target;
+    }
+}
