+package dev.comfyfluffy.caustica.minecraft.client.program;
+
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import net.minecraft.core.Holder;
+import net.minecraft.world.level.biome.Biome;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * Bedrock RTX's per-biome volumetric fog, exported from the Vanilla RTX pack's fog settings
+ * ({@code converter/export_fog.py}) and keyed by Java biome path. Coefficients are per block in linear BT.709:
+ * air ones scale with the profile's density, water ones apply as they are. {@code waterFogColour} is the sRGB colour of the
+ * biome's underwater distance fog.
+ */
+public final class BedrockFog {
+    /**
+     * Density profile: {@code maxHeight} and {@code zeroHeight} bound a linear fall from full density to none;
+     * NaN heights mean a uniform medium.
+     */
+    public record Profile(float density, float maxHeight, float zeroHeight) {
+        public boolean uniform() { return Float.isNaN(maxHeight); }
+    }
+
+    public record Entry(Profile air, Profile weather, float[] scattering, float[] absorption,
+                        float[] waterScattering, float[] waterAbsorption, float[] waterFogColour) { }
+
+    private static final Map<String, Entry> TABLE = load();
+    private static final Entry DEFAULT = Objects.requireNonNull(TABLE.get("plains"), "plains fog");
+
+    private BedrockFog() { }
+
+    public static Entry plains() {
+        return DEFAULT;
+    }
+
+    public static Entry of(Holder<Biome> biome) {
+        String path = biome.unwrapKey().map(key -> key.identifier().getPath()).orElse("plains");
+        Entry entry = TABLE.get(path);
+        if (entry == null && path.endsWith("_caves")) entry = TABLE.get("dripstone_caves");
+        return entry != null ? entry : DEFAULT;
+    }
+
+    private static Map<String, Entry> load() {
+        String path = "/assets/caustica/fog/bedrock_rtx_fog.json";
+        try (InputStream input = BedrockFog.class.getResourceAsStream(path)) {
+            if (input == null) throw new IllegalStateException("missing " + path);
+            JsonObject root = JsonParser.parseReader(new InputStreamReader(input, StandardCharsets.UTF_8))
+                    .getAsJsonObject();
+            Map<String, Entry> table = new HashMap<>();
+            for (var biome : root.entrySet()) {
+                JsonObject o = biome.getValue().getAsJsonObject();
+                table.put(biome.getKey(), new Entry(profile(o.get("air")), profile(o.get("weather")),
+                        vector(o, "scattering"), vector(o, "absorption"),
+                        vector(o, "waterScattering"), vector(o, "waterAbsorption"), vector(o, "waterFogColour")));
+            }
+            return Map.copyOf(table);
+        } catch (IOException failure) {
+            throw new UncheckedIOException(failure);
+        }
+    }
+
+    private static Profile profile(JsonElement element) {
+        if (element == null || element.isJsonNull()) return null;
+        var a = element.getAsJsonArray();
+        return new Profile(a.get(0).getAsFloat(), height(a.get(1)), height(a.get(2)));
+    }
+
+    private static float height(JsonElement element) {
+        return element.isJsonNull() ? Float.NaN : element.getAsFloat();
+    }
+
+    private static float[] vector(JsonObject o, String name) {
+        var a = o.getAsJsonArray(name);
+        return new float[]{a.get(0).getAsFloat(), a.get(1).getAsFloat(), a.get(2).getAsFloat()};
+    }
+}
