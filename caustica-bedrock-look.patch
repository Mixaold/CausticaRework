diff --git a/packages/renderer-presentation/src/main/java/dev/comfyfluffy/caustica/renderer/presentation/fog/FogBorder.java b/packages/renderer-presentation/src/main/java/dev/comfyfluffy/caustica/renderer/presentation/fog/FogBorder.java
