@@ -0,0 +1,180 @@
+package dev.comfyfluffy.caustica.minecraft.client;
+
+import dev.comfyfluffy.caustica.api.program.DevTune;
+import dev.comfyfluffy.caustica.renderer.runtime.ForkWeather;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.multiplayer.ClientLevel;
+import net.minecraft.core.BlockPos;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.EntityTypes;
+import net.minecraft.world.entity.LightningBolt;
+import net.minecraft.world.level.biome.Biome;
+import net.minecraft.world.phys.Vec3;
+
+/**
+ * Publishes {@link ForkWeather} once per frame: surfaces get wet over WET_SECONDS of rain at the camera and dry
+ * over DRY_SECONDS, and the nearest lightning bolt Minecraft spawned lights the scene for a short double flash.
+ * Rain only counts where the camera's biome rains (not in deserts or snow).
+ */
+public final class ForkWeatherCapture {
+    private static final float WET_SECONDS = 5.0f, DRY_SECONDS = 30.0f;
+    /**
+     * Sky luminance in cd/m² at the flash's peak however dark the sky: night sky is about 1e-3 to 1e-2, an overcast
+     * day thousands, so the flash turns a night into a bright dusk for an instant and adds little at noon.
+     */
+    private static final float FLASH_LUMINANCE = 5.0f;
+    /** Seconds over which the flash fades after the return stroke. */
+    private static final float FLASH_FADE_SECONDS = 0.45f;
+    private static long lastNanos;
+    /** Surface wetness 0..1 carried between frames; DevTune {@code fork.weather} scales what is published. */
+    private static float wetState;
+
+    /** Ids of bolts whose flash has started, so one bolt starts it once. */
+    private static final java.util.Set<Integer> seenBolts = new java.util.HashSet<>();
+    private static long flashStart;
+    private static int lastSkyFlash;
+    private static final java.util.Set<String> SEEN_CLASSES = new java.util.HashSet<>();
+    /** ClientLevel's sky flash accessor or field, or null when this version has neither. */
+    private static java.lang.reflect.Member skyFlashMember;
+    private static boolean skyFlashResolved;
+
+    private static int skyFlashTime(ClientLevel level) {
+        if (!skyFlashResolved) {
+            skyFlashResolved = true;
+            for (Class<?> type = level.getClass(); type != null && skyFlashMember == null; type = type.getSuperclass()) {
+                try {
+                    java.lang.reflect.Method method = type.getDeclaredMethod("getSkyFlashTime");
+                    method.setAccessible(true);
+                    skyFlashMember = method;
+                } catch (ReflectiveOperationException | RuntimeException ignored) {
+                    try {
+                        java.lang.reflect.Field field = type.getDeclaredField("skyFlashTime");
+                        field.setAccessible(true);
+                        skyFlashMember = field;
+                    } catch (ReflectiveOperationException | RuntimeException alsoIgnored) {
+                    }
+                }
+            }
+            LOGGER.info("[fork lightning] vanilla sky flash source: {}", skyFlashMember);
+        }
+        try {
+            if (skyFlashMember instanceof java.lang.reflect.Method method) return ((Number) method.invoke(level)).intValue();
+            if (skyFlashMember instanceof java.lang.reflect.Field field) return field.getInt(level);
+        } catch (ReflectiveOperationException | RuntimeException ignored) {
+        }
+        return 0;
+    }
+    private static int flashLogLines;
+    private static final int FLASH_LOG_LINES = 40;
+    private static final org.slf4j.Logger LOGGER = org.slf4j.LoggerFactory.getLogger("Caustica");
+
+    /** Bolt id and arrival time from the add-entity packet (any thread), read by the next frame's update. */
+    private static volatile int arrivedBolt = Integer.MIN_VALUE;
+    private static volatile long arrivedNanos;
+    private static int handledBolt = Integer.MIN_VALUE;
+
+    private ForkWeatherCapture() { }
+
+    /**
+     * A bolt's add-entity packet reached the client (ClientPacketListenerLightningMixin). The packet handler can run
+     * twice, on the network thread and again on the main thread, so the bolt id dedupes it.
+     */
+    public static void boltArrived(int id, double x, double y, double z) {
+        if (id == arrivedBolt) return;
+        arrivedNanos = System.nanoTime();
+        ForkWeather.boltX = x;
+        ForkWeather.boltY = y;
+        ForkWeather.boltZ = z;
+        arrivedBolt = id;
+        LOGGER.info("[fork lightning] add-entity packet for bolt {} at {} {} {}", id, x, y, z);
+    }
+
+    /**
+     * A bright strike, a short lull, a weaker return stroke and a fade, over {@code seconds} since the bolt appeared;
+     * DevTune {@code fork.flashLength} stretches it.
+     */
+    static float flashEnvelope(float seconds) {
+        float t = seconds / DevTune.get("fork.flashLength", 1.0f);
+        if (t < 0.10f) return 1.0f;
+        if (t < 0.16f) return 0.35f;
+        if (t < 0.30f) return 0.8f;
+        return Math.max(0.0f, 0.8f * (1.0f - (t - 0.30f) / FLASH_FADE_SECONDS));
+    }
+
+    static void update(Minecraft minecraft) {
+        ClientLevel level = minecraft.level;
+        long now = System.nanoTime();
+        float delta = lastNanos == 0L ? 0.0f : Math.min((now - lastNanos) * 1.0e-9f, 1.0f);
+        lastNanos = now;
+        if (level == null || minecraft.player == null) {
+            ForkWeather.wetness = 0.0f;
+            ForkWeather.rain = 0.0f;
+            ForkWeather.flash = 0.0f;
+            return;
+        }
+        float partial = minecraft.getDeltaTracker().getGameTimeDeltaPartialTick(false);
+        Vec3 camera = minecraft.gameRenderer.mainCamera().position();
+        BlockPos pos = BlockPos.containing(camera);
+        float rain = level.getRainLevel(partial);
+        if (rain > 0.0f && level.getBiome(pos).value().getPrecipitationAt(pos, level.getSeaLevel())
+                != Biome.Precipitation.RAIN) rain = 0.0f;
+        wetState = rain > 0.05f ? Math.min(rain, wetState + delta / WET_SECONDS)
+                : Math.max(0.0f, wetState - delta / DRY_SECONDS);
+        float published = DevTune.get("fork.weather", 1.0f);
+        ForkWeather.wetness = wetState * published;
+        ForkWeather.rain = rain * published;
+
+        // The flash runs on its own clock from the frame a new bolt first appears: vanilla may discard a bolt after
+        // three ticks, and a flash shorter than a few frames is averaged away by the temporal reconstruction.
+        double nearest = Double.MAX_VALUE;
+        boolean thunder = level.isThundering();
+        for (Entity entity : level.entitiesForRendering()) {
+            // During a thunderstorm every entity class seen for the first time goes to latest.log once, to show
+            // whether a bolt reaches the client's entity list at all.
+            if (thunder && SEEN_CLASSES.add(entity.getClass().getName())) {
+                LOGGER.info("[fork lightning] entity class in the client list during thunder: {} ({})",
+                        entity.getClass().getName(), entity.getType());
+            }
+            if (!(entity instanceof LightningBolt) && entity.getType() != EntityTypes.LIGHTNING_BOLT) continue;
+            Entity bolt = entity;
+            if (seenBolts.add(bolt.getId())) {
+                flashStart = now;
+                flashLogLines = 0;
+                LOGGER.info("[fork lightning] new bolt {} at {} {} {}, {} blocks from the camera", bolt.getId(),
+                        bolt.getX(), bolt.getY(), bolt.getZ(), Math.round(Math.sqrt(bolt.position().distanceToSqr(camera))));
+            }
+            double distance = bolt.position().distanceToSqr(camera);
+            if (distance >= nearest) continue;
+            nearest = distance;
+            ForkWeather.boltX = bolt.getX();
+            ForkWeather.boltY = bolt.getY();
+            ForkWeather.boltZ = bolt.getZ();
+        }
+        if (nearest == Double.MAX_VALUE && seenBolts.size() > 64) seenBolts.clear();
+        int arrived = arrivedBolt;
+        if (arrived != handledBolt) {
+            handledBolt = arrived;
+            seenBolts.add(arrived);
+            flashStart = arrivedNanos;
+            flashLogLines = 0;
+        }
+        // Vanilla's own sky flash: a bolt sets ClientLevel's skyFlashTime on the client. It starts the flash too,
+        // in case the bolt never shows in the entity list (read by name: 26.x ships unobfuscated).
+        int skyFlash = skyFlashTime(level);
+        if (skyFlash > 0 && lastSkyFlash <= 0 && (flashStart == 0L || now - flashStart > 500_000_000L)) {
+            flashStart = now;
+            flashLogLines = 0;
+            LOGGER.info("[fork lightning] vanilla sky flash time {} starts the flash", skyFlash);
+        }
+        lastSkyFlash = skyFlash;
+        float flash = flashEnvelope(flashStart == 0L ? Float.MAX_VALUE : (now - flashStart) * 1.0e-9f);
+        ForkWeather.flash = flash;
+        ForkWeather.flashLuminance = DevTune.get("fork.flashNits", FLASH_LUMINANCE);
+        // Every frame of a flash's first second goes to latest.log (at most FLASH_LOG_LINES lines per bolt).
+        if (flashStart != 0L && now - flashStart < 1_000_000_000L && flashLogLines < FLASH_LOG_LINES) {
+            flashLogLines++;
+            LOGGER.info("[fork lightning] {} ms after the bolt: flash {} flashNits {}", (now - flashStart) / 1_000_000L,
+                    flash, ForkWeather.flashLuminance);
+        }
+    }
+}
