@@ -0,0 +1,19 @@
+package dev.comfyfluffy.caustica.renderer.presentation.fog;
+
+/**
+ * Host-set distance fog at the edge of the loaded world, as Bedrock RTX hides the land past the render distance: the
+ * horizontal distances from the camera in blocks over which what the camera sees fades into the fog colour, and the
+ * gain on the frame's ambient radiance that gives that colour. The host writes them on its frame thread; the fog
+ * volume reads the latest values when it builds its parameters. An end of 0 disables it. Past the loaded land the
+ * view below the horizon meets a stand-in ground {@code groundDepth} blocks below the camera, fogged the same way.
+ */
+public final class FogBorder {
+    public static volatile float start = 0.0f;
+    public static volatile float end = 0.0f;
+    public static volatile float skyGain = 1.0f;
+    public static volatile float groundDepth = 64.0f;
+    /** Share of the horizon sky's colour the fog takes (below 1 at night, when the land sinks into a dimmer blue). */
+    public static volatile float horizonShare = 1.0f;
+
+    private FogBorder() { }
+}
diff --git a/packages/renderer-presentation/src/main/java/dev/comfyfluffy/caustica/renderer/presentation/fog/FogClouds.java b/packages/renderer-presentation/src/main/java/dev/comfyfluffy/caustica/renderer/presentation/fog/FogClouds.java
new file mode 100644
