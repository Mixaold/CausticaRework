+// Screen-space blue-noise pair in [0, 1)^2. With WorldPush.forkBlueNoiseAddress it is the void-and-cluster
+// blue noise that Bedrock RTX ships (Christoph Peters, CC0): 256×256 tiles, R and G independent, one of
+// BLUE_NOISE_SLICES tiles per frame. Otherwise one channel is the R2 dither mask (Roberts 2018), the other
+// interleaved gradient noise (Jimenez 2014). Both put their error at high spatial frequencies, so
+// neighbouring pixels get well-spread samples that the denoiser resolves as fine dither. A golden-ratio step
+// per channel each frame (each pass over the slices for the texture) keeps every pixel's sequence
+// equidistributed over time, so the estimate stays unbiased. `salt` shifts the pattern for independent uses
+// at one pixel.
+static const uint BLUE_NOISE_SIZE = 256u;
+static const uint BLUE_NOISE_SLICES = 32u;
+
+public float2 traceBlueNoise(uint2 pixel, uint frame, uint salt) {
+    uint64_t noise = ((ConstPtr<WorldPush>)worldBindings.worldPushAddress)[0].forkBlueNoiseAddress;
+    if (noise != 0u) {
+        uint2 p = (pixel + uint2(salt * 97u, salt * 57u)) % BLUE_NOISE_SIZE;
+        uint slice = (frame + salt * 11u) % BLUE_NOISE_SLICES;
+        uint texel = (slice * BLUE_NOISE_SIZE + p.y) * BLUE_NOISE_SIZE + p.x;
+        uint word = ((ConstPtr<uint>)noise)[texel >> 1u] >> ((texel & 1u) * 16u);
+        float2 v = (float2(float(word & 0xffu), float((word >> 8u) & 0xffu)) + 0.5) / 256.0;
+        float pass = float((frame / BLUE_NOISE_SLICES) & 0xffffu);
+        return frac(v + pass * float2(0.6180339887, 0.4142135624));
+    }
+    float2 p = float2(pixel + uint2(salt * 7u, salt * 13u) % 64u);
+    float r2 = frac(0.7548776662 * p.x + 0.5698402910 * p.y);
+    float ign = frac(52.9829189 * frac(0.06711056 * (p.x + 5.588238 * float(salt)) + 0.00583715 * p.y));
+    float f = float(frame & 0xffffu);
+    return frac(float2(r2 + f * 0.6180339887, ign + f * 0.4142135624));
+}
