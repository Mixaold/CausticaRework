+package dev.comfyfluffy.caustica.renderer.presentation.fog;
+
+/**
+ * Host-set scattering of the haze: the Henyey-Greenstein asymmetry of the light it scatters toward the camera and the
+ * share of the ambient sky light that lights it. Bedrock's daylight haze shows against the sun and in the sunlit air in
+ * front of it, and all but vanishes with the sun behind and in shade, so the host raises the asymmetry and lowers the
+ * ambient share by day. The host writes them on its frame thread; the fog volume reads the latest values.
+ */
+public final class FogHaze {
+    /** Asymmetry of water, smoke and night haze: a mild forward lobe. */
+    public static final float DEFAULT_ANISOTROPY = 0.45f;
+    public static volatile float anisotropy = DEFAULT_ANISOTROPY;
+    public static volatile float ambientShare = 1.0f;
+    /**
+     * Multiple of the haze density close to the camera, fading back to 1 between nearStart and nearEnd blocks away.
+     * Bedrock's sunbeams show in the air around the player while the far land stays clear: a dense near shell carries
+     * the shafts without veiling the distance. The camera's world position places the shell.
+     */
+    public static volatile float nearGain = 1.0f;
+    public static volatile float nearStart = 24.0f;
+    public static volatile float nearEnd = 64.0f;
+    public static volatile double cameraX, cameraY, cameraZ;
+    /** Gain on the sun's and moon's light the near shell scatters toward the camera: the beams, without more haze. */
+    public static volatile float beamGain = 1.0f;
+    /**
+     * Cap on the haze's phase toward the sun and the moon, in multiples of isotropic scattering, approached smoothly;
+     * 0 leaves the phase as it is. It keeps the forward peak from drawing a wide glowing halo around the disc.
+     */
+    public static volatile float sunPhaseCap = 0.0f;
+    /** Share of sunPhaseCap lifted inside the near shell (0 caps everywhere, 1 leaves the shell's phase as it is). */
+    public static volatile float capNear = 0.0f;
+    /** Traces the haze's sun and moon light to the centre of the disc: sharp shadow shafts instead of a soft glow. */
+    public static volatile boolean hardSun = false;
+
+    private FogHaze() { }
+}
